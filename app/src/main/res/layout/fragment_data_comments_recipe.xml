<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DataCommentsRecipeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_comments_recipe_data_form">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brevemente describe lo que más te gusta de esta receta y/o si tienes alguna idea para poder mejorarla"
            android:textSize="20sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_info_comments_recipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01/01/2026 12:00"
            android:textSize="15sp"
            android:textAlignment="textEnd"
            android:layout_marginBottom="10dp"/>

        <!-- Contenedor para permitir superponer el botón sobre el borde -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textCommentTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escribe tu comentario"
                app:errorEnabled="true"
                app:endIconMode="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textCommentValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="10"
                    android:paddingEnd="48dp"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/btn_comments_cancel"
                    android:maxLength="500"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón de borrar posicionado arriba a la derecha -->
            <ImageButton
                android:id="@+id/btnEliminateComment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/outline_cancel_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/design_default_color_primary"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintTop_toTopOf="@id/textCommentTextInput"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_comments_recipe_data_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/dividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="?android:attr/listDivider" />

        <Button
            android:id="@+id/btn_comments_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/design_default_color_secondary"
            android:text="Cancelar"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/btn_comments_save"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_comments_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/btn_comments_cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
