<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".DataRecetaFragment">

    <LinearLayout
        android:id="@+id/photo_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/photo_recipe"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:maxHeight="180dp"
            android:src="@drawable/baseline_add_a_photo_24"
            android:scaleType="fitCenter"
            android:contentDescription="Imagen de receta"/>
        <View
            android:id="@+id/dividerPhoto"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recipe_data_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/photo_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btns_recipe">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameRecipeTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:hint="Nombre receta"
            app:errorEnabled="true"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/outline_cancel_24"
            app:endIconTint="@color/design_default_color_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/descriptionRecipeTextInput" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameRecipeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/descriptionRecipeValue"
                android:maxLength="150"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descriptionRecipeTextInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:hint="Descripción"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/outline_cancel_24"
            app:endIconTint="@color/design_default_color_primary"
            app:layout_constraintTop_toBottomOf="@id/nameRecipeTextInput"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/prepTimeRecipeTextInput" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descriptionRecipeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/prepTimeRecipeValue"
                android:maxLength="500"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/prepTimeRecipeTextInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="2dp"
            android:hint="Tiempo de preparación (minutos)"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/outline_cancel_24"
            app:endIconTint="@color/design_default_color_primary"
            app:layout_constraintTop_toBottomOf="@id/descriptionRecipeTextInput"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/familyRecipeTextInput" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/prepTimeRecipeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/familyRecipeValue"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/familyRecipeTextInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:hint="Familia/Clasificación"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/outline_cancel_24"
            app:endIconTint="@color/design_default_color_primary"
            app:layout_constraintTop_toBottomOf="@id/prepTimeRecipeTextInput"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/labelRecipeTextInput" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/familyRecipeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/labelRecipeValue"
                android:maxLength="30"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/labelRecipeTextInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:hint="Etiqueta/Calorías"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/outline_cancel_24"
            app:endIconTint="@color/design_default_color_primary"
            app:layout_constraintTop_toBottomOf="@id/familyRecipeTextInput"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/labelRecipeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLength="30"/>

        </com.google.android.material.textfield.TextInputLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btns_recipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/recipe_data_form"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_recipe_data_form">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleButtonDataRecipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/btn_ingredients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredientes"
                android:textSize="12sp" />
            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/btn_howtomake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo de preparación"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_recipe_data_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/dividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="?android:attr/listDivider" />
        <Button
            android:id="@+id/btn_recipe_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/design_default_color_secondary"
            android:text="Cancelar"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/btn_recipe_save"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_recipe_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/btn_recipe_cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>