<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:backgroundTint="@color/md_theme_onPrimaryContainer"
    tools:context=".ui.PlanesViewHolder">

    <LinearLayout
        android:id="@+id/plan_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="5">

        <TextView
            android:id="@+id/planName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Plan"/>

        <TextView
            android:id="@+id/planDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Breve descripción" />

        <TextView
            android:id="@+id/planinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo plan · Etiqueta" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEliminate"
        android:contentDescription="Eliminar elemento"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:backgroundTint="@color/md_theme_background_highContrast"
        android:src="@drawable/outline_cancel_24" />

</LinearLayout>